<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- IIS'in WebDAV modülü PUT/DELETE gibi HTTP verb'lerini 405 ile engelliyor.
         API tamamen bu modülden bağımsız çalıştığı için kaldırıyoruz. -->
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
